# Backend API base URL (no trailing slash recommended)
#
# Local dev:
#   Backend: http://localhost:3001
#   Frontend: http://localhost:5173
#
# Preview deployments:
#   Set this to your backend preview origin, e.g.
#   VITE_API_BASE_URL=https://<your-backend-preview-host>:3001
VITE_API_BASE_URL=http://localhost:3001
